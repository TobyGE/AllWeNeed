{
  "name": "all-we-need",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:static": "vite build --config vite.static.config.ts",
    "build:static:legacy": "ALL_WE_NEED_STATIC_BASE=/intelligence/ vite build --config vite.static.config.ts",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "refresh": "node scripts/fetch-sources.mjs",
    "refresh:incremental": "node scripts/fetch-sources.mjs --output=tmp/feed-snapshot.json && node scripts/append-feed-updates.mjs --snapshot=tmp/feed-snapshot.json",
    "refresh:incremental:dry": "node scripts/fetch-sources.mjs --output=tmp/feed-snapshot.json && node scripts/append-feed-updates.mjs --snapshot=tmp/feed-snapshot.json --dry-run",
    "poll:feed": "node scripts/fetch-sources.mjs --output=tmp/feed-snapshot.json && node scripts/plan-feed-update.mjs --snapshot=tmp/feed-snapshot.json",
    "plan:feed": "node scripts/plan-feed-update.mjs --snapshot=tmp/feed-snapshot.json",
    "cycle:smart": "node scripts/run-smart-feed.mjs",
    "cycle:feed": "node scripts/run-feed-cycle.mjs",
    "cycle:feed:dry": "node scripts/run-feed-cycle.mjs --dry-run",
    "cycle:feed:resume": "node scripts/run-feed-cycle.mjs --resume",
    "baseline:current": "node scripts/append-feed-updates.mjs --snapshot=tmp/feed-snapshot.json --mark-baseline",
    "analyze": "node scripts/analyze-radar.mjs && npm run localize && npm run rewrite:companies && npm run ensure:explore",
    "localize": "node scripts/localize-radar.mjs && node scripts/expand-explore-articles.mjs",
    "expand:explore": "node scripts/expand-explore-articles.mjs",
    "rewrite:editorial": "node scripts/rewrite-editorial-stories.mjs",
    "rewrite:companies": "node scripts/rewrite-editorial-stories.mjs --company",
    "refresh:all": "npm run refresh:incremental && npm run ensure:explore",
    "ensure:explore": "node scripts/ensure-explore-depth.mjs",
    "eval:models": "node scripts/eval-model-prompts.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
